        <rule name="Blog redirect - top-10-restaurants-in-southbourne" stopProcessing="true">
          <match url="^top-10-restaurants-in-southbourne/?$" />
          <action type="Redirect" url="/blog/top-10-restaurants-in-southbourne/" redirectType="Permanent" />
        </rule>
        <rule name="Blog redirect - top-10-things-to-do-in-bournemouth" stopProcessing="true">
          <match url="^top-10-things-to-do-in-bournemouth/?$" />
          <action type="Redirect" url="/blog/top-10-things-to-do-in-bournemouth/" redirectType="Permanent" />
        </rule>
        <rule name="Blog redirect - where-to-eat-in-southbourne" stopProcessing="true">
          <match url="^where-to-eat-in-southbourne/?$" />
          <action type="Redirect" url="/blog/where-to-eat-in-southbourne/" redirectType="Permanent" />
        </rule>

        <!-- Legacy WordPress URLs (pre-2024 restructure) -> current new-site pages -->
        <rule name="Legacy redirect - about-our-school" stopProcessing="true">
          <match url="^about\-our\-school/?$" />
          <action type="Redirect" url="/about/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - about-our-school-accreditation" stopProcessing="true">
          <match url="^about\-our\-school/accreditation/?$" />
          <action type="Redirect" url="/about/testimonials-accreditations/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - about-our-school-join-our-team" stopProcessing="true">
          <match url="^about\-our\-school/join\-our\-team/?$" />
          <action type="Redirect" url="/about/join-our-team/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - about-our-school-join-our-team-main-school" stopProcessing="true">
          <match url="^about\-our\-school/join\-our\-team/main\-school/?$" />
          <action type="Redirect" url="/about/join-our-team/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - about-our-school-join-our-team-residential-centre" stopProcessing="true">
          <match url="^about\-our\-school/join\-our\-team/residential\-centre/?$" />
          <action type="Redirect" url="/about/join-our-team/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - about-our-school-latest-news" stopProcessing="true">
          <match url="^about\-our\-school/latest\-news/?$" />
          <action type="Redirect" url="/blog/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - about-our-school-our-team" stopProcessing="true">
          <match url="^about\-our\-school/our\-team/?$" />
          <action type="Redirect" url="/about/our-team/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - about-our-school-school-facilities" stopProcessing="true">
          <match url="^about\-our\-school/school\-facilities/?$" />
          <action type="Redirect" url="/about/school-facilities/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - about-our-school-school-policies-useful-information" stopProcessing="true">
          <match url="^about\-our\-school/school\-policies\-useful\-information/?$" />
          <action type="Redirect" url="/about/school-policies/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - about-our-school-video-and-gallery" stopProcessing="true">
          <match url="^about\-our\-school/video\-and\-gallery/?$" />
          <action type="Redirect" url="/about/gallery/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - about-our-team-join-our-team" stopProcessing="true">
          <match url="^about/our\-team/join\-our\-team/?$" />
          <action type="Redirect" url="/about/join-our-team/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - blog-visit-bournemouth-never-dull-moment" stopProcessing="true">
          <match url="^blog/visit\-bournemouth\-never\-dull\-moment/?$" />
          <action type="Redirect" url="/blog/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - book-pay-course" stopProcessing="true">
          <match url="^book\-pay\-course/?$" />
          <action type="Redirect" url="/english-courses/how-to-book-your-english-course/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - english-courses-adult-courses-examination-courses" stopProcessing="true">
          <match url="^english\-courses/adult\-courses/examination\-courses/?$" />
          <action type="Redirect" url="/english-courses/adult-language-courses/cambridge-examination-courses/" redirectType="Permanent" />
