        <rule name="Legacy redirect - english-courses-adult-courses-regular-courses-general-intensive" stopProcessing="true">
          <match url="^english\-courses/adult\-courses/regular\-courses\-general\-intensive/?$" />
          <action type="Redirect" url="/english-courses/adult-language-courses/general-intensive/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - english-courses-adult-courses-summer-vacation" stopProcessing="true">
          <match url="^english\-courses/adult\-courses/summer\-vacation/?$" />
          <action type="Redirect" url="/english-courses/adult-language-courses/summer-vacation-courses/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - english-courses-adult-language-courses-general-intensive-plus" stopProcessing="true">
          <match url="^english\-courses/adult\-language\-courses/general\-intensive\-plus/?$" />
          <action type="Redirect" url="/english-courses/adult-language-courses/one-to-one-english/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - english-courses-faq" stopProcessing="true">
          <match url="^english\-courses/faq/?$" />
          <action type="Redirect" url="/about/faqs/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - english-courses-junior-courses-bournemouth-collegiate-school" stopProcessing="true">
          <match url="^english\-courses/junior\-courses/bournemouth\-collegiate\-school/?$" />
          <action type="Redirect" url="/english-courses/junior-language-courses/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - english-courses-junior-courses-junior-closed-groups" stopProcessing="true">
          <match url="^english\-courses/junior\-courses/junior\-closed\-groups/?$" />
          <action type="Redirect" url="/english-courses/junior-language-courses/year-round-group-courses/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - english-courses-starting-at-southbourne-school" stopProcessing="true">
          <match url="^english\-courses/starting\-at\-southbourne\-school/?$" />
          <action type="Redirect" url="/english-courses/guide-to-levels/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - english-courses-starting-at-southbourne-school-guide-to-levels" stopProcessing="true">
          <match url="^english\-courses/starting\-at\-southbourne\-school/guide\-to\-levels/?$" />
          <action type="Redirect" url="/english-courses/guide-to-levels/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - language-courses" stopProcessing="true">
          <match url="^language\-courses/?$" />
          <action type="Redirect" url="/english-courses/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - language-courses-adult-language-courses-examination-courses" stopProcessing="true">
          <match url="^language\-courses/adult\-language\-courses/examination\-courses/?$" />
          <action type="Redirect" url="/english-courses/adult-language-courses/cambridge-examination-courses/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - language-courses-adult-language-courses-general-intensive-plus" stopProcessing="true">
          <match url="^language\-courses/adult\-language\-courses/general\-intensive\-plus/?$" />
          <action type="Redirect" url="/english-courses/adult-language-courses/one-to-one-english/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - language-courses-adult-language-courses-general-intensive" stopProcessing="true">
          <match url="^language\-courses/adult\-language\-courses/general\-intensive/?$" />
          <action type="Redirect" url="/english-courses/adult-language-courses/general-intensive/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - language-courses-adult-language-courses-intensive-course-plus" stopProcessing="true">
          <match url="^language\-courses/adult\-language\-courses/intensive\-course\-plus/?$" />
          <action type="Redirect" url="/english-courses/adult-language-courses/one-to-one-english/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - language-courses-adult-language-courses-summer-vacation-courses" stopProcessing="true">
          <match url="^language\-courses/adult\-language\-courses/summer\-vacation\-courses/?$" />
          <action type="Redirect" url="/english-courses/adult-language-courses/summer-vacation-courses/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - language-courses-how-to-book-your-course" stopProcessing="true">
          <match url="^language\-courses/how\-to\-book\-your\-course/?$" />
          <action type="Redirect" url="/english-courses/how-to-book-your-english-course/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - language-courses-junior-language-courses-spring-course" stopProcessing="true">
          <match url="^language\-courses/junior\-language\-courses/spring\-course/?$" />
          <action type="Redirect" url="/english-courses/junior-language-courses/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - language-courses-junior-language-courses-summer-courses" stopProcessing="true">
          <match url="^language\-courses/junior\-language\-courses/summer\-courses/?$" />
          <action type="Redirect" url="/english-courses/junior-language-courses/summer-courses/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - language-courses-junior-language-courses-year-round-group-courses" stopProcessing="true">
          <match url="^language\-courses/junior\-language\-courses/year\-round\-group\-courses/?$" />
          <action type="Redirect" url="/english-courses/junior-language-courses/year-round-group-courses/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - living-in-southbourne" stopProcessing="true">
          <match url="^living\-in\-southbourne/?$" />
          <action type="Redirect" url="/studying-in-bournemouth/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - living-in-southbourne-accommodation-and-welfare" stopProcessing="true">
          <match url="^living\-in\-southbourne/accommodation\-and\-welfare/?$" />
          <action type="Redirect" url="/studying-in-bournemouth/accommodation-welfare/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - living-in-southbourne-accommodation-and-welfare-become-a-host-family" stopProcessing="true">
          <match url="^living\-in\-southbourne/accommodation\-and\-welfare/become\-a\-host\-family/?$" />
          <action type="Redirect" url="/hosting-students/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - living-in-southbourne-accommodation-and-welfare-guest-houses-and-hotels" stopProcessing="true">
          <match url="^living\-in\-southbourne/accommodation\-and\-welfare/guest\-houses\-and\-hotels/?$" />
          <action type="Redirect" url="/studying-in-bournemouth/accommodation-welfare/guesthouses-hotels/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - living-in-southbourne-accommodation-and-welfare-host-families" stopProcessing="true">
          <match url="^living\-in\-southbourne/accommodation\-and\-welfare/host\-families/?$" />
          <action type="Redirect" url="/studying-in-bournemouth/accommodation-welfare/homestay/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - living-in-southbourne-activities-at-southbourne" stopProcessing="true">
          <match url="^living\-in\-southbourne/activities\-at\-southbourne/?$" />
          <action type="Redirect" url="/studying-in-bournemouth/school-activities/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - living-in-southbourne-how-to-reach-us" stopProcessing="true">
          <match url="^living\-in\-southbourne/how\-to\-reach\-us/?$" />
          <action type="Redirect" url="/studying-in-bournemouth/our-location/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - living-in-southbourne-travelling-to-britain" stopProcessing="true">
          <match url="^living\-in\-southbourne/travelling\-to\-britain/?$" />
          <action type="Redirect" url="/studying-in-bournemouth/travelling-to-britain/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - news" stopProcessing="true">
          <match url="^news/?$" />
          <action type="Redirect" url="/blog/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - news-gallery" stopProcessing="true">
          <match url="^news/gallery/?$" />
          <action type="Redirect" url="/about/gallery/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - oferta-especial" stopProcessing="true">
          <match url="^oferta\-especial/?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - online-enquiry-form" stopProcessing="true">
          <match url="^online\-enquiry\-form/?$" />
          <action type="Redirect" url="/english-courses/how-to-book-your-english-course/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - special-offer" stopProcessing="true">
          <match url="^special\-offer/?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy redirect - testimonials" stopProcessing="true">
          <match url="^testimonials/?$" />
          <action type="Redirect" url="/about/testimonials-accreditations/" redirectType="Permanent" />
        </rule>

        <!-- WordPress category/tag archive pages don't exist on the new site -->
        <rule name="Category archives to blog" stopProcessing="true">
          <match url="^category/.*" />
          <action type="Redirect" url="/blog/" redirectType="Permanent" />
        </rule>
        <rule name="Tag archives to blog" stopProcessing="true">
          <match url="^tag/.*" />
          <action type="Redirect" url="/blog/" redirectType="Permanent" />
        </rule>

        <!-- www -> non-www (canonical is non-www; scoped to the live domain only, -->
        <!-- so this never fires on the Fasthosts test/preview URL)               -->
        <rule name="Redirect www to non-www" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.southbourneschool\.co\.uk$" />
          </conditions>
          <action type="Redirect" url="https://southbourneschool.co.uk/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Force HTTPS on the live domain only (won't affect the test URL, -->
        <!-- which may not have a certificate applied yet)                   -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^(www\.)?southbourneschool\.co\.uk$" />
          </conditions>
          <action type="Redirect" url="https://southbourneschool.co.uk/{R:1}" redirectType="Permanent" />
        </rule>

      </rules>
    </rewrite>
  </system.webServer>
</configuration>
